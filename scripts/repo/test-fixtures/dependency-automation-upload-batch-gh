#!/usr/bin/env bash

set -euo pipefail

: "${MOCK_GH_STATE_DIR:?}"
: "${MOCK_ORCHESTRATION_SHA:?}"

repositories=(ext-authz budget-analyzer-web service-common workspace orchestration)

source_sha() {
  case "$1" in
    ext-authz) printf '%s\n' '75ed2bda4de7460332a8dea656def0459064753f' ;;
    budget-analyzer-web) printf '%s\n' '2cbef3f17f546fe167628b221a1cb9dec810c2bd' ;;
    service-common) printf '%s\n' 'e9b91a63eccbc3e7e98528d80cbe89677d0d1f94' ;;
    workspace) printf '%s\n' '6a6bf33fb019825b7709693a1b103c8a1dd7d726' ;;
    orchestration) printf '%s\n' "${MOCK_ORCHESTRATION_SHA}" ;;
    *) return 1 ;;
  esac
}

run_id() {
  case "$1" in
    ext-authz) printf '%s\n' 91001 ;;
    budget-analyzer-web) printf '%s\n' 91002 ;;
    service-common) printf '%s\n' 91003 ;;
    workspace) printf '%s\n' 91004 ;;
    orchestration) printf '%s\n' 91005 ;;
    *) return 1 ;;
  esac
}

artifact_name() {
  local repository="$1"
  local id
  id="$(run_id "${repository}")"
  case "${repository}" in
    ext-authz) printf 'trial-govulncheck-evidence-%s\n' "${id}" ;;
    budget-analyzer-web) printf 'trial-npm-audit-evidence-%s\n' "${id}" ;;
    service-common) printf 'trial-dependency-graph-evidence-%s\n' "${id}" ;;
    workspace) printf 'trial-workspace-image-evidence-%s\n' "${id}" ;;
    orchestration) printf 'trial-exact-image-security-evidence-%s\n' "${id}" ;;
    *) return 1 ;;
  esac
}

payload_name() {
  case "$1" in
    ext-authz) printf '%s\n' govulncheck-evidence.tar.gz ;;
    budget-analyzer-web) printf '%s\n' audit-evidence.tar.gz ;;
    service-common) printf '%s\n' dependency-graph-evidence.tar.gz ;;
    workspace) printf '%s\n' workspace-image-evidence.tar.gz ;;
    orchestration) printf '%s\n' image-security-evidence.tar.gz ;;
    *) return 1 ;;
  esac
}

repository_from_endpoint() {
  local value="${1#repos/budgetanalyzer/}"
  printf '%s\n' "${value%%/*}"
}

repository_from_run_id() {
  local wanted="$1"
  local repository
  for repository in "${repositories[@]}"; do
    if [[ "$(run_id "${repository}")" == "${wanted}" ]]; then
      printf '%s\n' "${repository}"
      return 0
    fi
  done
  return 1
}

command_name="${1:-}"
shift || true

case "${command_name}" in
  auth)
    exit 0
    ;;
  variable)
    echo 'The upload helper must use gh api for repository variables.' >&2
    exit 2
    ;;
  workflow)
    [[ "$1" == run ]]
    shift 2
    repository=""
    while [[ "$#" -gt 0 ]]; do
      case "$1" in
        --repo) repository="${2#budgetanalyzer/}"; shift 2 ;;
        --ref) shift 2 ;;
        *) shift ;;
      esac
    done
    touch "${MOCK_GH_STATE_DIR}/dispatched-${repository}"
    ;;
  api)
    method=GET
    jq_expression=""
    endpoint=""
    api_name=""
    api_value=""
    while [[ "$#" -gt 0 ]]; do
      case "$1" in
        --method) method="$2"; shift 2 ;;
        --jq) jq_expression="$2"; shift 2 ;;
        --paginate) shift ;;
        --slurp)
          echo 'The upload helper must use jq -s instead of gh api --slurp.' >&2
          exit 2
          ;;
        --header) shift 2 ;;
        -f|--raw-field)
          field_name="${2%%=*}"
          field_value="${2#*=}"
          case "${field_name}" in
            name) api_name="${field_value}" ;;
            value) api_value="${field_value}" ;;
          esac
          shift 2
          ;;
        *) endpoint="$1"; shift ;;
      esac
    done

    if [[ "${endpoint}" == "orgs/budgetanalyzer/repos?type=public&per_page=100" ]]; then
      [[ "${MOCK_FAIL_PUBLIC_STORAGE:-}" != true ]] || exit 1
      printf '[\n'
      separator=""
      for repository in "${repositories[@]}"; do
        printf '%s{"name":"%s","visibility":"public"}' "${separator}" "${repository}"
        separator=,
      done
      printf '\n]\n'
      exit 0
    fi

    repository="$(repository_from_endpoint "${endpoint}")"
    if [[ "${endpoint}" == repos/budgetanalyzer/*/actions/variables/* ]]; then
      variable="${endpoint##*/}"
      state_file="${MOCK_GH_STATE_DIR}/variable-${repository}-${variable}"
      case "${method}" in
        GET)
          value=false
          [[ ! -f "${state_file}" ]] || value="$(sed -n '1p' "${state_file}")"
          if [[ -n "${jq_expression}" ]]; then
            printf '%s\n' "${value}"
          else
            printf '{"name":"%s","value":"%s"}\n' "${variable}" "${value}"
          fi
          ;;
        PATCH)
          [[ "${api_name}" == "${variable}" && -n "${api_value}" ]]
          printf '%s\n' "${api_value}" > "${state_file}"
          printf '%s %s %s\n' "${repository}" "${variable}" "${api_value}" \
            >> "${MOCK_GH_STATE_DIR}/variable.log"
          ;;
        *) exit 2 ;;
      esac
      exit 0
    fi
    if [[ "${endpoint}" == repos/budgetanalyzer/*/git/ref/heads/* ]]; then
      sha="$(source_sha "${repository}")"
      if [[ -n "${jq_expression}" ]]; then
        printf '%s\n' "${sha}"
      else
        printf '{"object":{"sha":"%s"}}\n' "${sha}"
      fi
      exit 0
    fi
    if [[ "${endpoint}" == "repos/budgetanalyzer/${repository}" ]]; then
      if [[ -n "${jq_expression}" ]]; then
        printf '%s\n' dependency-automation-trial
      else
        printf '%s\n' '{"default_branch":"dependency-automation-trial"}'
      fi
      exit 0
    fi
    if [[ "${endpoint}" == repos/budgetanalyzer/*/actions/caches\?per_page=100 ]]; then
      printf '%s\n' '{"actions_caches":[]}'
      exit 0
    fi
    if [[ "${endpoint}" == repos/budgetanalyzer/*/actions/artifacts\?per_page=100 ]]; then
      if [[ "${MOCK_RESUME_ARTIFACT:-}" == true && "${repository}" == ext-authz ]]; then
        id="$(run_id "${repository}")"
        artifact_id="$((id + 200000))"
        if [[ ! -f "${MOCK_GH_STATE_DIR}/deleted.log" ]] \
          || ! grep -Fxq "${artifact_id}" "${MOCK_GH_STATE_DIR}/deleted.log"; then
          printf '{"artifacts":[{"id":%s,"name":"%s","size_in_bytes":512,"expires_at":"2026-09-18T12:00:00Z","expired":false,"workflow_run":{"id":%s,"head_branch":"dependency-automation-trial","head_sha":"%s"}}]}\n' \
            "${artifact_id}" "$(artifact_name "${repository}")" "${id}" "$(source_sha "${repository}")"
          exit 0
        fi
      fi
      printf '%s\n' '{"artifacts":[]}'
      exit 0
    fi
    if [[ "${endpoint}" == repos/budgetanalyzer/*/actions/workflows/*/runs\?* ]]; then
      if [[ -f "${MOCK_GH_STATE_DIR}/dispatched-${repository}" ]]; then
        id="$(run_id "${repository}")"
        sha="$(source_sha "${repository}")"
        if [[ -n "${jq_expression}" ]]; then
          printf '[%s]\n' "${id}"
        else
          printf '{"workflow_runs":[{"id":%s,"head_sha":"%s","created_at":"2026-09-17T12:00:00Z"}]}\n' \
            "${id}" "${sha}"
        fi
      elif [[ -n "${jq_expression}" ]]; then
        printf '%s\n' '[]'
      else
        printf '%s\n' '{"workflow_runs":[]}'
      fi
      exit 0
    fi
    if [[ "${endpoint}" =~ /actions/runs/([0-9]+)/jobs\?per_page=100$ ]]; then
      id="${BASH_REMATCH[1]}"
      repository="$(repository_from_run_id "${id}")"
      conclusion=success
      [[ "${MOCK_FAIL_REPOSITORY:-}" == "${repository}" ]] && conclusion=failure
      printf '{"jobs":[{"id":%s,"status":"completed","conclusion":"%s"}]}\n' \
        "$((id + 100000))" "${conclusion}"
      exit 0
    fi
    if [[ "${endpoint}" =~ /actions/runs/([0-9]+)/artifacts\?per_page=100$ ]]; then
      id="${BASH_REMATCH[1]}"
      repository="$(repository_from_run_id "${id}")"
      sha="$(source_sha "${repository}")"
      name="$(artifact_name "${repository}")"
      artifact_id="$((id + 200000))"
      if [[ -f "${MOCK_GH_STATE_DIR}/deleted.log" ]] \
        && grep -Fxq "${artifact_id}" "${MOCK_GH_STATE_DIR}/deleted.log"; then
        printf '%s\n' '{"artifacts":[]}'
        exit 0
      fi
      printf '{"artifacts":[{"id":%s,"name":"%s","size_in_bytes":512,"expires_at":"2026-09-18T12:00:00Z","workflow_run":{"id":%s,"head_sha":"%s"}}]}\n' \
        "${artifact_id}" "${name}" "${id}" "${sha}"
      exit 0
    fi
    if [[ "${endpoint}" =~ /actions/runs/([0-9]+)$ ]]; then
      id="${BASH_REMATCH[1]}"
      repository="$(repository_from_run_id "${id}")"
      sha="$(source_sha "${repository}")"
      conclusion=success
      [[ "${MOCK_FAIL_REPOSITORY:-}" == "${repository}" ]] && conclusion=failure
      printf '{"id":%s,"status":"completed","conclusion":"%s","head_branch":"dependency-automation-trial","head_sha":"%s","event":"workflow_dispatch","html_url":"https://example.invalid/%s"}\n' \
        "${id}" "${conclusion}" "${sha}" "${id}"
      exit 0
    fi
    if [[ "${endpoint}" =~ /actions/artifacts/([0-9]+)/zip$ ]]; then
      artifact_id="${BASH_REMATCH[1]}"
      id="$((artifact_id - 200000))"
      repository="$(repository_from_run_id "${id}")"
      payload="$(payload_name "${repository}")"
      command cp "${MOCK_GH_STATE_DIR}/zips/${payload}.zip" /dev/stdout
      exit 0
    fi
    if [[ "${method}" == DELETE && "${endpoint}" =~ /actions/artifacts/([0-9]+)$ ]]; then
      printf '%s\n' "${BASH_REMATCH[1]}" >> "${MOCK_GH_STATE_DIR}/deleted.log"
      exit 0
    fi
    echo "Unhandled mock gh api endpoint: ${method} ${endpoint}" >&2
    exit 2
    ;;
  *)
    echo "Unhandled mock gh command: ${command_name}" >&2
    exit 2
    ;;
esac
